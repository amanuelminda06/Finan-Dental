# Local embedded Postgres for development and verification.
# `npm run db:up` starts 127.0.0.1:5433/vision_erp; keep these URLs local.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/vision_erp"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/vision_erp"

# Multi-tenancy
# Where `/` redirects and which tenant seeds/scripts use. Never a fallback in
# request handling: the tenant is always resolved from the URL.
DEFAULT_TENANT_SLUG="finan"

# Auth
AUTH_SECRET=""
AUTH_URL=""
LOGIN_SECRET_PATH=""

# Seeded accounts
OWNER_EMAIL=""
OWNER_PASSWORD=""
RECEPTION_EMAIL=""
RECEPTION_PASSWORD=""
STAFF_EMAIL=""
STAFF_PASSWORD=""

# Uploads
UPLOAD_DIR="storage/uploads"
STORAGE_DRIVER="db"

# Public site
PUBLIC_BASE_URL=""
NEXT_PUBLIC_TRIAL_BANNER="false"
SMS_SENDER_NAME="FinanDental"

# Turnstile (required in production)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Cron
CRON_SECRET=""

# Demo data
SEED_DEMO_DATA="false"
